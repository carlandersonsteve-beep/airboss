# Copy this file to .env for local development.
# GroundCore uses a thin Node backend plus Postgres.

PORT=8787
HOST=127.0.0.1

# Required for hosted deployments. Change this from the dev default.
SESSION_SECRET=change-me-before-hosting
CHECKIN_SECRET=change-me-before-hosting-too

# Comma-separated browser origins allowed to call the API in shared/hosted mode.
# Example:
# ALLOWED_ORIGINS=https://groundcore.example.com,https://ops.groundcore.example.com
ALLOWED_ORIGINS=

# Use your Postgres connection string here.
# Supabase can back this, but GroundCore talks to it through Postgres/DATABASE_URL,
# not through a browser-only client.
# Example:
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/groundcore
DATABASE_URL=

# TLS mode for hosted Postgres. Default keeps certificate verification on.
# Use `require` only when your provider requires TLS but presents a chain
# your runtime does not trust yet.
# Supported: verify-full | require | no-verify | disable
DATABASE_SSL_MODE=verify-full

# Optional PEM CA certificate contents for hosted Postgres verification.
# Supports literal PEM with newlines or \n-escaped newlines.
DATABASE_SSL_CA=

# Trust proxy-provided client IPs only when you are definitely behind a trusted proxy
# that sanitizes X-Forwarded-For (for example, a hosted load balancer you control).
TRUST_PROXY=

# Simple single-instance login throttling defaults.
# Five failed attempts inside five minutes will block that username+IP for fifteen minutes.
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_BLOCK_MS=900000

# Public kiosk abuse controls. Limits are per source IP inside the shared window.
CHECKIN_RATE_LIMIT_WINDOW_MS=600000
CHECKIN_SESSION_RATE_LIMIT=60
CHECKIN_LOOKUP_RATE_LIMIT=30
CHECKIN_WRITE_RATE_LIMIT=40
